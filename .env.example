# Anthropic API-Key (erforderlich für die KI-Analyse)
ANTHROPIC_API_KEY=sk-ant-...

# Automatischer E-Mail-Eingang (optional — aktiv, sobald die drei IMAP_* Werte gesetzt sind)
# Beispiel Gmail: IMAP_HOST=imap.gmail.com (App-Passwort nötig)
# Beispiel IONOS: IMAP_HOST=imap.ionos.de
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_INTERVAL_SECONDS=120

# Optionale Overrides
QUOTE_DB_PATH=quotes.db
UPLOAD_DIR=uploads
HOURLY_PRODUCTION_RATE_EUR=95.0
OVERHEAD_PERCENT=0.15
TARGET_MARGIN_PERCENT=0.30
